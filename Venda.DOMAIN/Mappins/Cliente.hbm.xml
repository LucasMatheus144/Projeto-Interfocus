<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
				   namespace="Venda.DOMAIN.Entities"
				   assembly="Venda.DOMAIN">
	<class name="Cliente" lazy="false" table="cliente">
		<id name="Id" column="id">
			<generator class="sequence">
				<param name="sequence">clientes_seq</param>
			</generator>
		</id>
		<property name="Nome" column="nome" length="25" not-null="true"/>
		<property name="DataNascimento" column="d_nascimento" type="Date" not-null="true"/>
		<property name="Cpf" column="cpf" length="14" not-null="true" unique="true"/>
		<property name="Email" column="email" length="50" not-null="false"/>
		<property name="situacao" column="situacao" not-null="true"/>
	</class>
</hibernate-mapping>